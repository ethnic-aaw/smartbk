# Salin file ini menjadi .env lalu isi password yang kuat.
# .env TIDAK boleh di-commit ke git (sudah ditambahkan ke .gitignore).
#
# Catatan: jika .env tidak dibuat, docker compose tetap berjalan memakai
# password default (smartbk_ChangeMe_2025). Untuk penggunaan nyata/produksi,
# WAJIB buat .env dan ganti password di bawah ini.

# Kredensial database yang dipakai aplikasi
# Catatan: hindari spasi, #, $, dan tanda kutip di password agar tidak
# salah dibaca oleh shell/MySQL. Contoh aman: Smartbk2025!Aman
DB_USER=smartbk
DB_PASS=ganti_dengan_password_kuat

# Password root MySQL (hanya untuk administrasi container)
MYSQL_ROOT_PASSWORD=ganti_dengan_root_password_kuat

# ==========================================
# Google OAuth 2.0 Credentials
# Dapatkan dari: https://console.cloud.google.com/
# Lihat panduan: docs/GOOGLE_OAUTH_SETUP.md
# ==========================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:9000/smartbk/auth/google_callback.php