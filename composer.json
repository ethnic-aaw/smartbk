{
    "name": "smartbk/smartbk",
    "description": "Smart BK - Sistem Informasi Bimbingan Konseling",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "google/apiclient": "^2.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SmartBK\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/*": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!file_exists('.env')) { copy('.env.example', '.env'); echo 'Created .env from .env.example\\n'; }\""
        ],
        "test": "phpunit",
        "lint": "php -l"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}