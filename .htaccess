Options -Indexes
RewriteEngine On

RewriteRule ^api/ - [L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s(/[^?\s]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L,QSA]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s(/[^?\s]+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)/?$ $1.php [L]

RewriteCond %{REQUEST_URI} ^(.*)\.html$
RewriteCond %{DOCUMENT_ROOT}/%1.php -f
RewriteRule ^ /%1.php [L]

# --- Keamanan global ---
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer-when-downgrade"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # img/svg/icons di CDN Google Font tidak dipakai; batasi ke aset lokal.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'"
</IfModule>
